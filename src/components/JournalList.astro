---
import type { CollectionEntry } from 'astro:content';
import JournalItem from './JournalItem.astro';

type Journal = CollectionEntry<'journal'>;
const { journals } = Astro.props;

function groupJournalsByYear(journals: Journal[]) {
	const grouped = journals.reduce(
		(acc, journal) => {
			const year = journal.data.pubDate.getFullYear();
			if (!acc[year]) {
				acc[year] = [];
			}
			acc[year].push(journal);
			return acc;
		},
		{} as Record<number, Journal[]>
	);

	return Object.entries(grouped)
		.sort(([a], [b]) => Number(b) - Number(a))
		.map(([year, journals]) => ({
			year: Number(year),
			journals: journals.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
		}));
}

const groupedJournals = groupJournalsByYear(journals);
---

{
	groupedJournals.map(({ year, journals }) => (
		<div class='mb-8'>
			<h2 class='text-2xl font-bold mb-4'>{year}</h2>
			<div>
				{journals.map((journal: Journal) => (
					<JournalItem journal={journal} />
				))}
			</div>
		</div>
	))
}
