---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseLayout from '@src/layouts/BaseLayout.astro';
import { slugify, unslugify } from '@src/utils';
import PostsByYear from '@src/components/PostsByYear.astro';
import JournalList from '@src/components/JournalList.astro';
import { TAGS_ITEM_PAGE } from '@src/consts';
import Tag from '@src/components/Tag.astro';

type BlogPost = CollectionEntry<'blog'>;
type Journal = CollectionEntry<'journal'>;

export const getStaticPaths = async () => {
	const allPosts: BlogPost[] = await getCollection('blog');
	const allJournal: Journal[] = await getCollection('journal');

	return [
		...new Set(
			[...allPosts, ...allJournal]
				.map((post) => post.data.tags)
				.flat()
				.filter((tag) => !!tag)
		)
	].map((tag) => ({ params: { tag: slugify(tag || '') } }));
};

const { tag } = Astro.params;
const allPosts: BlogPost[] = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const allJournals: Journal[] = (await getCollection('journal')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const taggedPosts = allPosts.filter((post) => post.data.tags?.map((tag) => slugify(tag)).includes(tag || ''));
const taggedJournals = allJournals.filter((journal) => journal.data.tags?.map((tag) => slugify(tag)).includes(tag || ''));

const title = `All Posts Tagged with ${unslugify(tag || '')}`;
const description = `All Posts Tagged with ${unslugify(tag || '')}`;
---

<BaseLayout title={TAGS_ITEM_PAGE.pageTitle} description={TAGS_ITEM_PAGE.seo_description}>
	<div class='container'>
		<Tag class='inline-block mb-10' label={unslugify(tag || '')} />
		{
			taggedPosts.length > 0 && (
				<div class='mb-10'>
					<h2 class='text-2xl font-bold mb-2'>{TAGS_ITEM_PAGE.blogHeading}</h2>
				</div>
			)
		}
		<PostsByYear posts={taggedPosts} />
		{
			taggedJournals.length > 0 && (
				<div class='mb-10'>
					<h2 class='text-2xl font-bold mb-2'>{TAGS_ITEM_PAGE.journalHeading}</h2>
				</div>
			)
		}

		<JournalList journals={taggedJournals} />
	</div>
</BaseLayout>
