---
import { SITE_TITLE, SITE_DESCRIPTION, ABOUT, PROFILE } from '../consts';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Ava from '@src/assets/img/ava.jpg';
import Prose from '../components/Prose.astro';
import { openSourceContributions, workProjects, type OpenSourceContribution, type WorkProject } from './projects/projects';

import PostItem from '../components/PostItem.astro';
import ListScaffold from '@src/components/ListScaffold.astro';
import OpenSourceContributionCard from '@src/components/OpenSourceContributionCard.astro';
import WorkProjectCard from '@src/components/WorkProjectCard.astro';
import Social from '@src/components/Social.astro';
import { allSocials } from '@src/socials';
import Link from '@src/components/Link.astro';
import PingTag from '@src/components/PingTag.astro';

type BlogPost = CollectionEntry<'blog'>;

const posts = (await getCollection('blog'))
	.sort((a: BlogPost, b: BlogPost) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);

const featuredOpenSourceProjects: OpenSourceContribution[] = openSourceContributions.filter((projects) => projects.toFeatureOnHome);
const featuredWorkProjects: WorkProject[] = workProjects.filter((projects) => projects.toFeatureOnHome);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<div class='container'>
		<div class='w-full md:flex md:items-center gap-16 mb-10'>
			<div class='text-pretty leading-9'>
				<h1 class='text-4xl font-bold mb-4'>Hi 👋, {ABOUT.name} Here!</h1>
				<Prose>
					<div class='text-lg'>
						<p>
							{ABOUT.short}
						</p>
					</div>
				</Prose>
				<div class='cta-container flex flex-wrap items-start gap-4'>
					<div class='social-links-container inline-flex flex-wrap gap-3 mb-4'>
						{allSocials.map((social) => <Social socialItem={social} />)}
					</div>
					<PingTag label={ABOUT.pingText} />
				</div>
				<div class='link-container text-right'>
					<Link text='View Resume' url={PROFILE.resumeLink} />
				</div>
			</div>
			<Image src={Ava} alt={ABOUT.name} loading='eager' class='w-[300px] rounded-3xl rotate-3 mx-auto md:mx-0' />
		</div>
		<main>
			<div class='mt-6 mb-12'>
				<div class='flex justify-between gap-2 border-b mb-1 dark:border-b-zinc-700'>
					<h2 class='text-lg font-bold mb-3'>Recent Posts</h2>
					<a href='/posts/' class='inline-block py-2 underline dark:prose-invert'>All posts &raquo;</a>
				</div>
				<div>
					{posts.map((post: BlogPost) => <PostItem post={post} />)}
				</div>
				<div class='text-right'></div>
			</div>
			<div>
				<div class='flex justify-between gap-2 mb-1'>
					<h2 class='text-lg font-bold mb-3'>Featured Projects</h2>
					<a href='/projects/' class='inline-block py-2 underline dark:prose-invert'>All projects &raquo;</a>
				</div>
				<ListScaffold>
					{
						featuredOpenSourceProjects.map((contribution: OpenSourceContribution) => (
							<OpenSourceContributionCard contribution={contribution} />
						))
					}
					{featuredWorkProjects.map((workProject: WorkProject) => <WorkProjectCard workProject={workProject} />)}
				</ListScaffold>
			</div>
		</main>
	</div>
</BaseLayout>
