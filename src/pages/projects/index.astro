---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { openSourceContributions, workProjects, type OpenSourceContribution, type WorkProject } from './projects';
import { PROJECTS_PAGE } from '@src/consts';
import ListScaffold from '../../components/ListScaffold.astro';
import OpenSourceContributionCard from '@src/components/OpenSourceContributionCard.astro';
import WorkProjectCard from '@src/components/WorkProjectCard.astro';
---

<BaseLayout title={PROJECTS_PAGE.pageTitle} description={PROJECTS_PAGE.seo_description}>
	<div class='container text-center'>
		<div class='mb-10'>
			<h1 class='text-3xl font-bold mb-2'>{PROJECTS_PAGE.heading}</h1>
			<p class='text-zinc-700 dark:text-zinc-300 text-lg'>{PROJECTS_PAGE.subHeading}</p>
		</div>
	</div>

	<div class='container mb-10'>
		<div class='mb-4'>
			<h2 class='text-2xl font-bold'>🚀 Open Source Contributions</h2>
		</div>
		<ListScaffold>
			{openSourceContributions.map((contribution: OpenSourceContribution) => <OpenSourceContributionCard contribution={contribution} />)}
		</ListScaffold>
	</div>
	<div class='container'>
		<div class='mb-4'>
			<h2 class='text-2xl font-bold'>👨🏻‍💻 Professional Work Projects</h2>
		</div>
		<ListScaffold>
			{workProjects.map((workProject: WorkProject) => <WorkProjectCard workProject={workProject} />)}
		</ListScaffold>
	</div>
</BaseLayout>
